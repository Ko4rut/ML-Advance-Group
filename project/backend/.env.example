# Copy to .env in the SAME directory as project/backend/pyproject.toml.
# Keep .env private; it is already excluded by the repository .gitignore.
# This relative path is resolved from project/backend, regardless of terminal cwd.
XIANGQI_TABULAR_Q_CHECKPOINT=models/tabular_q/q_table.json.gz

# Alternative: use Google Drive instead of a downloaded local checkpoint.
# Comment out XIANGQI_TABULAR_Q_CHECKPOINT before using the Drive file ID.
# XIANGQI_TABULAR_Q_DRIVE_FILE_ID=1pU8pcxCwWLCaKj44OT8ZvWOy1Cd8AA9c

# Optional: override CORS if the frontend runs at a different origin.
# XIANGQI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Neural MCTS opponent; search settings: configs/neural_mcts.yaml.
# Roll back neural availability without affecting other agents; restart API after changes.
# XIANGQI_NEURAL_ENABLED=false
# Weights are NOT in git. Provision them with scripts/fetch_neural_checkpoint.py (see models/neural/README.md).
# Model key from models/neural/manifest.json: distill-v4-large (default) or distill-v4.
# XIANGQI_NEURAL_MODEL=distill-v4-large
# Optional override of the file location (absolute, or relative to project/backend).
# Default: models/neural/<model>.pt
# XIANGQI_NEURAL_MODEL_PATH=models/neural/distill-v4-large.pt
# Optional assertion only: must equal the SHA-256 pinned in the manifest, it cannot add trust.
# XIANGQI_NEURAL_MODEL_SHA256=05927ccd874c4d97588ba7d06266fda9ba17700d436fdc03ff6844a0d61d0dff
# Only "cpu" is supported and validated.
# XIANGQI_NEURAL_DEVICE=cpu
# Optional torch CPU thread count (process-global). Unset leaves torch's default.
# XIANGQI_NEURAL_THREADS=4
